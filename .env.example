# Port configuration (defaults shown)
# PORT=3001            # API server port
# VITE_PORT=5173       # Vite dev server port
# VITE_API_PORT=3001   # API port the Vite proxy targets (must match PORT)

# Agent token for Claude Code (create via Settings > Agent Tokens)
AGENT_TOKEN_CLAUDE_CODE=

# Dedicated progress-photo media key: exactly 32 random bytes in canonical base64.
# Keep separate from JWT_SECRET, source control, SQLite, and backup archives.
BODY_PROGRESS_MEDIA_KEY=
